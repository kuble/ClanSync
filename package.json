{
  "name": "clansync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:qa": "node scripts/dev-qa.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:reset": "supabase db reset",
    "db:push": "node scripts/with-dotenv-local.mjs db push",
    "db:link": "node scripts/supabase-link.mjs",
    "types:gen": "node scripts/generate-db-types.mjs",
    "db:sync": "npm run db:push && npm run types:gen",
    "db:seed": "node scripts/seed-fixtures.mjs",
    "db:test:push": "node scripts/supabase-test.mjs push",
    "db:test:types": "node scripts/supabase-test.mjs types",
    "debug:supabase": "node scripts/debug-supabase-games.mjs",
    "test:e2e": "playwright test",
    "test:db": "node --test --test-concurrency=1 scripts/review-db.test.mjs scripts/clan-notices-db.test.mjs scripts/profile-badge-db.test.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:env-check": "node e2e/check-e2e-env.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
